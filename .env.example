# Copy this file to `.env` (or `.env.local`, which overrides it) at the repo root.
# Both `./gradlew bootRun` and `docker compose` read them, so you don't have to export
# secrets each restart. Format: KEY=value, no quotes, no `export`; `#` comments and empty
# values are ignored. Real environment variables always take precedence (prod/CI).
#
# ── Backend ──────────────────────────────────────────────────────────────
# Anthropic API key (backend only; the frontend never talks to Anthropic)
ANTHROPIC_API_KEY=

# Static bearer token for the whole API. Empty = no auth (development only).
ITACA_API_TOKEN=

# Finance: comma-separated counterparty names (yourself, partner, joint money)
# whose movements are transfers, not spending — so they're kept out of the
# monthly spending view. e.g. "Oriol Subirana Perdiguer,Paula Alvo Serrano"
ITACA_FINANCE_TRANSFER_NAMES=

# Postgres. Locally, docker-compose starts one on host port 5433 (override with
# ITACA_DB_PORT). In production, point to the Supabase Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/itaca
SPRING_DATASOURCE_USERNAME=itaca
SPRING_DATASOURCE_PASSWORD=itaca

# Supabase Storage for all ingested documents (lab reports AND finance statements).
# Create a (private) Storage bucket named like SUPABASE_BUCKET; the service_role key
# (a long eyJ... JWT) bypasses RLS. Empty SUPABASE_URL = use local disk instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# Strava (Garmin -> Strava bridge; bike/run/hike activities). Register an app at
# strava.com/settings/api with Authorization Callback Domain "localhost".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Single-user shortcut: instead of the OAuth web flow, get a long-lived refresh
# token once by hand and the backend seeds the account on first sync (prod then
# needs no callback domain). One time, with your client id/secret:
#   1. Open in a browser (approve, then copy the ?code=... from the redirect URL):
#      https://www.strava.com/oauth/authorize?client_id=ID&response_type=code&redirect_uri=http://localhost&approval_prompt=force&scope=activity:read_all
#   2. Exchange the code for tokens (the response's refresh_token goes below):
#      curl -X POST https://www.strava.com/oauth/token -d client_id=ID -d client_secret=SECRET -d code=CODE -d grant_type=authorization_code
STRAVA_REFRESH_TOKEN=

# Google sign-in + Calendar/Drive (auth phase). Create an OAuth client (Web app) at
# console.cloud.google.com with redirect URI http://localhost:8080/login/oauth2/code/google,
# and enable the Gmail/Calendar/Drive APIs. Restricted scopes need the consent screen in
# "Testing" with your email as a test user (refresh tokens then expire after 7 days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may sign in (also the principal the stored tokens are keyed by).
ITACA_ALLOWED_EMAIL=
# Drive folder to watch: drop documents (PDFs/CSVs) here and Ítaca ingests them. The id is the
# last path segment of the folder's URL (drive.google.com/drive/folders/<THIS>). Empty = off.
GOOGLE_DRIVE_FOLDER_ID=

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Token the frontend sends as Authorization: Bearer (same as ITACA_API_TOKEN)
VITE_API_TOKEN=
# Dev only: backend origin for the Google login/logout redirects (prod is same-origin).
VITE_AUTH_BASE=
