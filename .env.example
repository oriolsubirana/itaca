# ── Backend ──────────────────────────────────────────────────────────────
# API key de Anthropic (solo backend; el frontend nunca habla con Anthropic)
ANTHROPIC_API_KEY=

# Bearer token estático para toda la API. Vacío = sin auth (solo desarrollo).
ITACA_API_TOKEN=

# Postgres. En local, docker-compose levanta uno con estos valores por defecto.
# En producción, apunta al Postgres de Supabase.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/itaca
SPRING_DATASOURCE_USERNAME=itaca
SPRING_DATASOURCE_PASSWORD=itaca

# Supabase Storage (fases de analíticas e ingesta)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Token que el frontend envía como Authorization: Bearer (igual que ITACA_API_TOKEN)
VITE_API_TOKEN=
